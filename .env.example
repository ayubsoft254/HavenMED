# ─────────────────────────────────────────────────────────────────────────────
# HavenMED — Environment Variables
# Copy this file to .env and fill in your values before running Docker.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,havenmed.example.com,www.havenmed.example.com
CSRF_TRUSTED_ORIGINS=https://havenmed.example.com,https://www.havenmed.example.com
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ── Database (SQLite — default) ───────────────────────────────────────────────
# SQLite path is controlled inside settings.py (BASE_DIR / db.sqlite3).
SQLITE_PATH=/data/db.sqlite3
# For PostgreSQL, install psycopg2 and change the DATABASES block in settings.py:
# DATABASE_URL=postgres://user:password@db:5432/havenmed

# ── Docker production paths and port ──────────────────────────────────────────
APP_PORT=18000
HOST_DATA_DIR=/opt/havenmed/shared/data
HOST_MEDIA_DIR=/opt/havenmed/shared/media
HOST_STATIC_DIR=/opt/havenmed/shared/staticfiles

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=HavenMED <your-email@gmail.com>
ADMIN_USER_NAME=HavenMED Admin
ADMIN_USER_EMAIL=admin@yourdomain.com

# Allauth email verification mode: mandatory | optional | none
ACCOUNT_EMAIL_VERIFICATION=mandatory

# ── Django site ID ───────────────────────────────────────────────────────────
SITE_ID=1
